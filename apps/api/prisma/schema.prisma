model audit_logs {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int?     @db.UnsignedInt
  action      String   @db.VarChar(80)
  entity_type String?  @db.VarChar(60)
  entity_id   Int?     @db.UnsignedInt
  metadata    Json?
  ip_address  String?  @db.VarChar(45)
  created_at  DateTime @default(now())
  users       users?   @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_logs_user")

  @@index([action, created_at], map: "idx_audit_logs_action_created")
  @@index([entity_type, entity_id, created_at], map: "idx_audit_logs_entity_created")
  @@index([user_id, created_at], map: "idx_audit_logs_user_created")
}

